{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focusd",
  "version": "0.1.0",
  "identifier": "dev.hemlix.focusd",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../app",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../app"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "title": "Focusd",
        "width": 1500,
        "height": 980,
        "minWidth": 720,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "focusd"
        ]
      },
      "mobile": [
        {
          "host": "focus.hemlix.dev",
          "pathPrefix": [
            "/add"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}